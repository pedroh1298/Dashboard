# Bling ERP API v3 Credentials
BLING_CLIENT_ID=seu_client_id_aqui
BLING_CLIENT_SECRET=seu_client_secret_aqui
BLING_REDIRECT_URI=https://dashboardmarketplace.vercel.app/api/bling/callback

# Provedores de IA
ACTIVE_AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# Supabase server-side token storage
SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_URL também é aceito quando criado pela integração da Vercel
SUPABASE_SECRET_KEY=sb_secret_sua_chave_aqui

# Dashboard authentication
# Use uma chave aleatória exclusiva com pelo menos 32 caracteres
AUTH_SESSION_SECRET=gere_uma_chave_aleatoria_longa
DASHBOARD_PASSWORD_SALT=base64url_do_salt
DASHBOARD_PASSWORD_HASH=base64url_do_hash_pbkdf2
DASHBOARD_PASSWORD_ITERATIONS=600000
